# Optional absolute path for the local SQLite file.
# Default: <workspace>/.data/harness.sqlite
HARNESS_DB_PATH=
HARNESS_API_PORT=3001
# Eigenes Codex-Modell für den QA-Tester; ändert nicht Mira oder den Entwickler.
MANAGER_CODEX_MODEL=gpt-5.6-luna
MANAGER_CODEX_REASONING_EFFORT=medium
# Maximale Laufzeit pro Mira-Aufruf; Standard: 180 Sekunden.
MANAGER_TIMEOUT_MS=180000
DEVELOPER_CODEX_MODEL=gpt-5.6-terra
DEVELOPER_CODEX_REASONING_EFFORT=medium
TESTER_CODEX_MODEL=gpt-5.6-luna
TESTER_CODEX_REASONING_EFFORT=medium
# Inaktivitätsgrenzen: laufende Ausgabe verhindert den Timeout.
TESTER_IDLE_TIMEOUT_MS=600000
TESTER_MAX_RUN_MS=1800000
PROJECT_TEST_IDLE_TIMEOUT_MS=900000
PROJECT_TEST_MAX_TIMEOUT_MS=3600000
# Leases werden alle 30 Sekunden erneuert; nach einem Prozessabbruch wird der Lauf freigegeben.
AGENT_LEASE_TTL_MS=120000
# Begrenzungen gegen automatische Endlosschleifen.
TESTER_RECOVERY_LIMIT=3
TESTER_FAILURE_CHAIN_LIMIT=3
